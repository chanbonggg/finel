# Docker Compose production template. Copy to .env only on the deployment host.
# Do not commit the resulting .env or real certificates.

POSTGRES_DB=finel
POSTGRES_USER=finel
POSTGRES_PASSWORD=replace-with-a-long-random-password

# New Flyway-owned database only. Keep false for an existing database until a
# separately approved baseline/migration procedure has completed.
SPRING_FLYWAY_ENABLED=false

PUBLIC_SITE_URL=https://www.example.com
AUTH_COOKIE_DOMAIN=
JWT_SECRET=replace-with-at-least-32-random-bytes

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=finel/products

# Generate one long random value and use it for both containers through Compose.
REVALIDATE_SECRET=replace-with-a-long-random-secret

# Enable only for a deliberate one-time administrator bootstrap.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
