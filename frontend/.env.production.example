# Public browser API path. Do not use Docker service names here.
NEXT_PUBLIC_API_BASE_URL=/api

# Docker-internal address used by Next.js server rendering and proxy.ts.
SERVER_API_BASE_URL=http://finel-backend:8080

# Public HTTPS URL used for metadata, canonical URLs, and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Runtime-only shared secret for /internal/revalidate.
# Set this in the server root .env; do not commit a value here.
REVALIDATE_SECRET=
